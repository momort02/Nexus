{
  "name": "@nexus/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node --env-file=../../.env node_modules/prisma/build/index.js migrate dev",
    "prisma:migrate:deploy": "node --env-file=../../.env node_modules/prisma/build/index.js migrate deploy"
  },
  "dependencies": {
    "@nexus/shared": "workspace:*",
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.6",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "socket.io": "^4.8.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.19.3",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.1.3"
  }
}
