# Port used by the local API server.
API_PORT=3000

# PostgreSQL connection string used by Prisma. Keep these credentials local.
DATABASE_URL=postgresql://nexus_dev:nexus_local_dev_change_me@127.0.0.1:5432/nexus?schema=public

# Local PostgreSQL container settings. The example password is not suitable
# for production or any database exposed outside your development machine.
POSTGRES_DB=nexus
POSTGRES_USER=nexus_dev
POSTGRES_PASSWORD=nexus_local_dev_change_me
POSTGRES_PORT=5432

# Discord OAuth2 application credentials. Create these in the Discord
# Developer Portal; register the callback URL below exactly. Use localhost
# (not 127.0.0.1) to open the local web app so the OAuth state cookie is sent
# to this callback host.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/v1/auth/discord/callback

# Frontend origin used after authentication and for logout Origin checks.
APP_ORIGIN=http://localhost:5173

# 32-byte encryption key encoded as 64 hexadecimal characters.
# Generate locally with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
OAUTH_ENCRYPTION_KEY=

# Controls Secure cookie attributes; use production when served over HTTPS.
NODE_ENV=development

# Local Redis container port (reserved for application cache/coordination).
REDIS_PORT=6379

# Discord bot token; required only when running the bot.
DISCORD_BOT_TOKEN=

# API origin used by Vite's development proxy.
VITE_API_TARGET=http://127.0.0.1:3000

# Bot-to-API ingestion endpoint and local health endpoint.
BOT_API_BASE_URL=http://localhost:3000/api/internal/v1/discord/events
BOT_HEALTH_PORT=3001

# Shared HMAC secret for authenticated bot event ingestion. Generate locally
# with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BOT_API_SECRET=

# Stable HMAC key used to pseudonymize member IDs for daily distinct-user
# analytics. Keep it secret; rotating it resets cross-period deduplication.
# Generate locally with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BOT_ANALYTICS_KEY=
