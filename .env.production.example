# Copy to .env.production on the VM. Never commit the filled-in file.
DOMAIN=nexus.momort02.com

# These credentials are used by PostgreSQL and must be URL-safe.
# Generate the password with: openssl rand -hex 32
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=replace_with_openssl_rand_hex_32

# Discord Developer Portal > OAuth2 > Redirects must contain this exact URL.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://nexus.momort02.com/api/v1/auth/discord/callback
APP_ORIGIN=https://nexus.momort02.com

# Generate each key independently with: openssl rand -hex 32
OAUTH_ENCRYPTION_KEY=replace_with_a_distinct_openssl_rand_hex_32
BOT_API_SECRET=replace_with_a_distinct_openssl_rand_hex_32
BOT_ANALYTICS_KEY=replace_with_a_distinct_openssl_rand_hex_32

# Discord bot token; keep it private and rotate it if it is ever exposed.
DISCORD_BOT_TOKEN=
